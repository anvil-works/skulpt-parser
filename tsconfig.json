{
    "compilerOptions": {
        "target": "ES2020",
        "rootDir": "src",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "experimentalDecorators": true,
        "useDefineForClassFields": false,
        "skipLibCheck": true,
        "strict": true,
        "types": ["node"]
    },
    "include": ["src/**/*.ts"]
}
