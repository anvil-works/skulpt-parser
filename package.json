{
    "name": "@anvil-works/skulpt-parser",
    "version": "0.0.1-dev.7",
    "type": "module",
    "packageManager": "pnpm@10.10.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "rslib build --config rslib.core.config.ts",
        "test": "rstest run",
        "test:watch": "rstest",
        "check": "tsc --noEmit --project tsconfig.tests.json",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:package": "node --experimental-vm-modules scripts/check-package.mjs",
        "upstream:prepare": "python3 -m tools.upstream prepare",
        "upstream:check": "python3.14 -m tools.upstream check",
        "test:upstream": "python3 -m unittest tools.upstream.test_inputs",
        "generate:ast": "python3.14 -m tools.generate314",
        "generate:check": "python3.14 -m tools.generate314 --check",
        "generate:parser": "python3.14 -m tools.generate314 --parser",
        "build:expression": "rslib build --config rslib.expression.config.ts",
        "test:python314-corpus": "node scripts/check-python314-corpus.mjs",
        "test:expression-package": "node --experimental-vm-modules scripts/check-expression-package.mjs",
        "bench:python314": "node scripts/benchmark-python314.mjs",
        "bench:browser": "node scripts/benchmark-browser.mjs",
        "probe:robustness": "node scripts/check-robustness.mjs",
        "build:core": "pnpm build",
        "test:core-package": "node --experimental-vm-modules scripts/check-core-package.mjs",
        "perf:report": "node scripts/report-performance.mjs",
        "prepack": "pnpm build",
        "prepublishOnly": "node scripts/validate-release-version.mjs",
        "test:release": "node --test scripts/validate-release-version.test.mjs"
    },
    "exports": {
        ".": {
            "types": "./dist-core/index.d.ts",
            "import": "./dist-core/index.js"
        },
        "./core": {
            "types": "./dist-core/index.d.ts",
            "import": "./dist-core/index.js"
        },
        "./unicode-names": {
            "types": "./dist-core/string_names.d.ts",
            "import": "./dist-core/unicode-names.js"
        },
        "./optimize": {
            "types": "./dist-core/optimize_ast.d.ts",
            "import": "./dist-core/optimize.js"
        }
    },
    "devDependencies": {
        "@rslib/core": "1.0.0",
        "@rstest/core": "0.11.12",
        "@types/node": "22.15.3",
        "playwright": "1.63.0",
        "prettier": "3.8.1",
        "typescript": "5.9.3"
    },
    "description": "Python 3.14 parser and tokenizer for JavaScript, with bounded Python 2 compatibility",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/anvil-works/skulpt-parser.git"
    },
    "files": [
        "dist-core",
        "licenses"
    ],
    "publishConfig": {
        "access": "public"
    }
}
