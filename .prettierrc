{
    "trailingComma": "es5",
    "tabWidth": 4,
    "printWidth": 120,
    "bracketSameLine": true,
    "proseWrap": "never",
    "overrides": [
        {
            "files": "*.md",
            "options": {
                "proseWrap": "preserve",
                "tabWidth": 2
            }
        }
    ]
}
